//@version=6
// DeepRise TradingView companion. Independent calculations on TradingView chart candles.
// This is NOT a live link to the DeepRise scanner's alerts or scores.
indicator("DeepRise | Structure Companion", shorttitle="DeepRise SMC", overlay=true, max_boxes_count=150, max_labels_count=300, max_lines_count=250)

span = input.int(3, "Confirmed pivot: candles either side", minval=2, maxval=10, group="Market structure")
showSwings = input.bool(true, "HH / HL / LH / LL", group="Market structure")
showBreaks = input.bool(true, "BOS / CHoCH", group="Market structure")
showProtected = input.bool(true, "Protected high / low", group="Market structure")
showOB = input.bool(true, "Confirmed order blocks", group="Smart money")
showFVG = input.bool(true, "Fair value gaps", group="Smart money")
extendZones = input.int(36, "Zone extension (bars)", minval=1, maxval=150, group="Smart money")
showFib = input.bool(false, "Fib 0.5 / 0.618 / 0.786", group="Fibonacci")
ema20On = input.bool(true, "EMA 20", group="Indicators")
ema50On = input.bool(true, "EMA 50", group="Indicators")

float atr = ta.atr(14)
float swingH = ta.pivothigh(high, span, span)
float swingL = ta.pivotlow(low, span, span)
var float lastH = na
var float lastL = na
var float prevH = na
var float prevL = na
var int highIndex = na
var int lowIndex = na
var bool highBroken = false
var bool lowBroken = false
var int bias = 0
var float protectedHigh = na
var float protectedLow = na

if not na(swingH)
    prevH := lastH
    lastH := swingH
    highIndex := bar_index - span
    highBroken := false
    if showSwings
        string hType = na(prevH) ? "H" : swingH > prevH ? "HH" : swingH < prevH ? "LH" : "EQH"
        label.new(highIndex, swingH, hType, style=label.style_label_down, size=size.tiny, color=color.new(color.red, 65), textcolor=color.white)
if not na(swingL)
    prevL := lastL
    lastL := swingL
    lowIndex := bar_index - span
    lowBroken := false
    if showSwings
        string lType = na(prevL) ? "L" : swingL < prevL ? "LL" : swingL > prevL ? "HL" : "EQL"
        label.new(lowIndex, swingL, lType, style=label.style_label_up, size=size.tiny, color=color.new(color.teal, 65), textcolor=color.white)

bool breakUp = barstate.isconfirmed and not na(lastH) and not na(highIndex) and bar_index > highIndex and not highBroken and close > lastH
bool breakDown = barstate.isconfirmed and not na(lastL) and not na(lowIndex) and bar_index > lowIndex and not lowBroken and close < lastL
bool bullChoch = breakUp and bias == -1
bool bearChoch = breakDown and bias == 1

if breakUp
    highBroken := true
    if showBreaks
        line.new(highIndex, lastH, bar_index, lastH, color=color.new(color.lime, 15), style=line.style_dashed)
        label.new(bar_index, lastH, bullChoch ? "CHoCH ↑" : "BOS ↑", color=color.new(color.green, 30), textcolor=color.white, style=label.style_label_down, size=size.small)
    if showOB and not na(atr) and math.abs(close-open) >= atr * 0.32 and close-lastH >= atr * 0.07
        int origin = na
        for k = 1 to 8
            if close[k] < open[k]
                origin := k
                break
        if not na(origin)
            box.new(left=bar_index-origin, top=open[origin], right=bar_index+extendZones, bottom=low[origin], border_color=color.new(color.teal, 25), bgcolor=color.new(color.teal, 85), text="BULL OB", text_color=color.new(color.white, 20), text_size=size.tiny)
    protectedLow := lastL
    protectedHigh := na
    bias := 1
else if breakDown
    lowBroken := true
    if showBreaks
        line.new(lowIndex, lastL, bar_index, lastL, color=color.new(color.red, 15), style=line.style_dashed)
        label.new(bar_index, lastL, bearChoch ? "CHoCH ↓" : "BOS ↓", color=color.new(color.red, 30), textcolor=color.white, style=label.style_label_up, size=size.small)
    if showOB and not na(atr) and math.abs(close-open) >= atr * 0.32 and lastL-close >= atr * 0.07
        int origin = na
        for k = 1 to 8
            if close[k] > open[k]
                origin := k
                break
        if not na(origin)
            box.new(left=bar_index-origin, top=high[origin], right=bar_index+extendZones, bottom=open[origin], border_color=color.new(color.red, 25), bgcolor=color.new(color.red, 85), text="BEAR OB", text_color=color.new(color.white, 20), text_size=size.tiny)
    protectedHigh := lastH
    protectedLow := na
    bias := -1

bool bullGap = barstate.isconfirmed and not na(high[2]) and not na(atr) and low > high[2] and low-high[2] >= atr*0.05
bool bearGap = barstate.isconfirmed and not na(low[2]) and not na(atr) and high < low[2] and low[2]-high >= atr*0.05
if showFVG and bullGap
    box.new(bar_index-2, low, bar_index+extendZones, high[2], border_color=color.new(color.teal, 60), bgcolor=color.new(color.teal, 91), text="FVG", text_color=color.new(color.teal, 10), text_size=size.tiny)
if showFVG and bearGap
    box.new(bar_index-2, low[2], bar_index+extendZones, high, border_color=color.new(color.red, 60), bgcolor=color.new(color.red, 91), text="FVG", text_color=color.new(color.red, 10), text_size=size.tiny)

plot(showProtected ? protectedHigh : na, "Protected high", color=color.red, linewidth=2, style=plot.style_linebr)
plot(showProtected ? protectedLow : na, "Protected low", color=color.teal, linewidth=2, style=plot.style_linebr)
plot(ema20On ? ta.ema(close, 20) : na, "EMA 20", color=color.yellow, linewidth=2)
plot(ema50On ? ta.ema(close, 50) : na, "EMA 50", color=color.blue, linewidth=2)

float leg = not na(lastH) and not na(lastL) ? lastH-lastL : na
float fib50 = not na(leg) ? bias == 1 ? lastH-leg*0.5 : lastL+leg*0.5 : na
float fib618 = not na(leg) ? bias == 1 ? lastH-leg*0.618 : lastL+leg*0.618 : na
float fib786 = not na(leg) ? bias == 1 ? lastH-leg*0.786 : lastL+leg*0.786 : na
plot(showFib ? fib50 : na, "Fib 0.5", color=color.new(color.orange, 35), style=plot.style_linebr)
plot(showFib ? fib618 : na, "Fib 0.618", color=color.orange, style=plot.style_linebr)
plot(showFib ? fib786 : na, "Fib 0.786", color=color.new(color.orange, 35), style=plot.style_linebr)
alertcondition(breakUp, "DeepRise bullish BOS / CHoCH", "Bullish closed-candle structure break")
alertcondition(breakDown, "DeepRise bearish BOS / CHoCH", "Bearish closed-candle structure break")
